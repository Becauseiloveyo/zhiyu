ZHIYU_ENV=dev
ZHIYU_DATABASE_URL=postgresql+psycopg://zhiyu:zhiyu_dev_only@postgres:5432/zhiyu
ZHIYU_LOG_LEVEL=INFO
# Compose is loopback-only development infrastructure. Use a URL-safe password.
POSTGRES_PASSWORD=zhiyu_dev_only
ZHIYU_API_PORT=8000
# Empty identity configuration fails closed for all business APIs.
# Keys are sha256(high-entropy-token); values bind principal_id/environment_ids/
# collector_ids/source_types/permissions. See README for local setup.
ZHIYU_SERVICE_TOKENS={}
